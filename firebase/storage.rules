rules_version = '2';

// Shared by Speed Basketball and We Got Game (same Firebase project).
// Keep this file identical in both repositories.
service firebase.storage {
  match /b/{bucket}/o {

    // Main admin by email (keep in sync with ADMIN_EMAILS in src/lib/media.*),
    // plus any extra admins listed in the Firestore `admins` collection.
    function isAdmin() {
      return request.auth != null && (
        ('email' in request.auth.token
          && request.auth.token.email.lower() in ['office@speed-basketball.ro'])
        || firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }

    match /media/{site}/{fileName} {
      allow read: if true;

      // Uploads: images up to 20 MB, videos up to 500 MB.
      allow create, update: if isAdmin()
        && site in ['speed', 'wgg']
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 20 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 500 * 1024 * 1024)
        );

      allow delete: if isAdmin();
    }
  }
}
