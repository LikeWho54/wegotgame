# OPTIONAL. The shared Firebase project "speedandwgg" is already configured in
# src/lib/firebase.*. Set these only to point a build at a different project
# (in .env.local, or Netlify → Site configuration → Environment variables).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
